# OpenAI API key used by the planner and executor.
OPENAI_API_KEY=your-openai-api-key

# LLM selection and retry behavior.
PRIMARY_MODEL=gpt-6-luna
FALLBACK_MODEL=gpt-5.4-mini
MAX_ATTEMPTS=3
RETRY_DELAY=1

# Agent safety limits.
MAX_TASKS=7
RECURSION_LIMIT=50

# Directory where generated Word documents are saved.
OUTPUT_DIR=outputs
